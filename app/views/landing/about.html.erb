<% content_for(:title, t('landing.about.page_title')) %>
<% content_for(:description, t('landing.about.page_description')) %>

<%# ── HERO ── %>
<section class="relative overflow-hidden" style="min-height: 380px;">
  <%= image_tag('workshop.jpg', alt: t('landing.about.workshop_alt'), class: "absolute inset-0 w-full h-full object-cover", loading: "eager") %>
  <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(15,4,4,0.88) 0%, rgba(140,18,25,0.65) 60%, rgba(15,4,4,0.75) 100%);"></div>

  <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 flex flex-col items-center justify-center text-center py-28">
    <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 text-white/80 text-xs font-bold uppercase tracking-widest mb-6">
      <i class="fa-solid fa-gem text-ruby-400 text-xs"></i>
      <%= t('landing.about.page_title') %>
    </div>
    <h1 class="text-white font-extrabold leading-tight mb-4" style="font-size: clamp(2rem, 5vw, 3.5rem);">
      <%= t('landing.about.title') %>
    </h1>
    <p class="text-white/75 text-lg max-w-2xl">
      <%= t('landing.about.page_description') %>
    </p>
  </div>
</section>

<%# ── STORY SECTION ── %>
<section class="py-20 lg:py-28 px-6 lg:px-8 arc-section-white">
  <div class="max-w-6xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-16 items-start">

      <%# Left: Story text %>
      <div>
        <div class="inline-flex items-center gap-2 bg-ruby-50 text-ruby-600 rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-widest mb-5">
          <i class="fa-solid fa-book-open text-xs"></i>
          <%= t('landing.about.page_title') %>
        </div>
        <h2 class="arc-heading mb-8"><%= t('landing.about.title') %></h2>

        <div class="space-y-6 arc-text-muted leading-relaxed text-base">
          <p><%= t('landing.about.description_1') %></p>
          <p><%= t('landing.about.description_2') %></p>
          <p><%= t('landing.about.description_3') %></p>
        </div>
      </div>

      <%# Right: Pull quote + timeline %>
      <div class="space-y-8">
        <div class="arc-pull-quote text-gray-800 dark:text-gray-100">
          <%= t('landing.about.description_3').truncate(200) %>
        </div>

        <div>
          <h3 class="font-bold arc-text-base text-lg mb-6 flex items-center gap-2">
            <i class="fa-solid fa-timeline text-ruby-600 text-sm"></i>
            <%= t('landing.about.journey_title', default: 'Our Journey') %>
          </h3>
          <div class="arc-timeline">
            <div class="arc-timeline-item">
              <p class="font-bold arc-text-base">2010 — <%= t('landing.about.founded', default: 'Founded') %></p>
              <p class="arc-text-faint text-sm mt-1"><%= t('landing.about.founded_desc', default: 'African Ruby Community established in Nairobi, Kenya') %></p>
            </div>
            <div class="arc-timeline-item">
              <p class="font-bold arc-text-base">2013 — <%= t('landing.about.regional_growth', default: 'Regional Growth') %></p>
              <p class="arc-text-faint text-sm mt-1"><%= t('landing.about.regional_desc', default: 'Expanded chapters across Uganda, Tanzania, and Rwanda') %></p>
            </div>
            <div class="arc-timeline-item">
              <p class="font-bold arc-text-base">2017 — <%= t('landing.about.first_conf', default: 'First RubyConf Africa') %></p>
              <p class="arc-text-faint text-sm mt-1"><%= t('landing.about.first_conf_desc', default: "Hosted the continent's first dedicated Ruby conference") %></p>
            </div>
            <div class="arc-timeline-item">
              <p class="font-bold arc-text-base">2023 — 5,000+ <%= t('landing.index.intro.members_count') %></p>
              <p class="arc-text-faint text-sm mt-1"><%= t('landing.about.members_desc', default: 'Community grew to over 5,000 members across East Africa') %></p>
            </div>
            <div class="arc-timeline-item">
              <p class="font-bold arc-text-base"><%= Time.now.year %> — <%= t('landing.about.growing', default: 'Growing Strong') %></p>
              <p class="arc-text-faint text-sm mt-1"><%= t('landing.about.growing_desc', default: "Continuing to build Africa's Ruby ecosystem") %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ── MINASWAN Banner ── %>
<section class="py-14 px-6 lg:px-8 arc-hero-ruby">
  <div class="relative z-10 max-w-3xl mx-auto text-center">
    <p class="text-white/60 text-xs font-bold uppercase tracking-widest mb-3"><%= t('landing.about.philosophy_label', default: 'Our Philosophy') %></p>
    <h2 class="text-white font-black text-3xl lg:text-4xl mb-4">M.I.N.A.S.W.A.N</h2>
    <p class="text-white/80 text-lg">
      <em><%= t('landing.about.minaswan', default: 'Matz Is Nice And So We Are Nice') %></em> — <%= t('landing.about.minaswan_desc', default: "the Ruby community's guiding principle that we live by every day.") %>
    </p>
  </div>
</section>

<%# ── CTA ── %>
<section class="py-20 px-6 lg:px-8 arc-section-white text-center">
  <div class="max-w-2xl mx-auto">
    <h2 class="arc-heading arc-heading-center mb-4"><%= t('landing.about.cta_title', default: 'Ready to Join Us?') %></h2>
    <p class="arc-text-faint mb-8"><%= t('landing.about.cta_desc', default: "Be part of Africa's most vibrant Ruby developer community.") %></p>
    <div class="flex flex-wrap justify-center gap-4">
      <%= link_to new_user_registration_path, class: "arc-btn-ruby" do %>
        <i class="fa-solid fa-users text-sm"></i>
        <%= t('common.actions.join_us') %>
      <% end %>
      <%= link_to chapters_path, class: "arc-btn-outline" do %>
        <%= t('chapters.index.title') %>
        <i class="fa-solid fa-map-pin text-xs"></i>
      <% end %>
    </div>
  </div>
</section>
