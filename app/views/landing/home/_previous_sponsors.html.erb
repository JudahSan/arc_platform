<%# ── PREVIOUS SPONSORS ── %>
<section class="py-16 px-6 lg:px-8 ">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-10">
      <h2 class="arc-heading arc-heading-center text-2xl"><%= t('landing.index.sponsors.previous_title') %></h2>
      <p class="arc-text-base mt-3 text-sm"><%= t('landing.index.sponsors.previous_hint', default: 'Organizations that have supported our mission over the years') %></p>
    </div>

    <div class="flex flex-wrap justify-center items-center gap-8 lg:gap-12 mb-12">
      <% previous_sponsors.each do |sponsor| %>
        <%= link_to sponsor[:link], target: '_blank', rel: 'noopener' do %>
          <div class="flex items-center justify-center w-28 h-14 hover:scale-105 transition-transform duration-300">
            <%= image_tag sponsor[:image], alt: t(sponsor[:alt_key]), class: 'max-w-full max-h-full object-contain' %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="text-center">
      <a href="mailto:organisers@rubycommunity.africa" class="arc-btn-ruby">
        <i class="fa-solid fa-handshake text-sm"></i>
        <%= t('landing.index.sponsors.become_sponsor') %>
      </a>
    </div>
  </div>
</section>
