<%# ── CHAPTERS (Always Dark Mode) ── %>
<section class="dark py-20 lg:py-28 px-6 lg:px-8 relative overflow-hidden">
  <%# Background image layer - isolated from any .dark section overrides %>
  <div class="absolute inset-0" style="background-image: url(<%= image_path('countries.png') %>); background-size: cover; background-position: center;"></div>
  <%# Dark overlay - always visible %>
  <div class="absolute inset-0 bg-gray-950/80"></div>
  <div class="relative z-10 max-w-7xl mx-auto">
    <div class="text-center mb-14">
      <h2 class="text-white font-extrabold mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem);">
        <%= t('landing.index.chapters.title') %>
      </h2>
      <p class="text-gray-300 max-w-lg mx-auto"><%= t('landing.index.chapters.subtitle') %></p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
      <% chapters.each do |chapter| %>
        <%= link_to new_user_registration_path, class: "group" do %>
          <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-5 flex flex-col items-center gap-3 hover:bg-ruby-600/80 hover:border-ruby-500/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-ruby-900/30">
            <%= image_tag chapter[:image], alt: t(chapter[:alt_key]), class: 'h-14 w-auto object-contain group-hover:scale-110 transition-transform duration-300' %>
            <p class="text-white font-bold text-center text-sm"><%= t(chapter[:country_key]) %></p>
            <span class="text-white/60 text-xs group-hover:text-white/90 transition-colors font-medium"><%= t('landing.index.chapters.join_community') %></span>
          </div>
        <% end %>
      <% end %>
      <%# Request new chapter card %>
      <a href="mailto:organisers@rubycommunity.africa" class="group">
        <div class="bg-white/5 backdrop-blur-sm border border-dashed border-white/30 rounded-2xl p-5 flex flex-col items-center gap-3 hover:bg-white/15 hover:border-white/50 transition-all duration-300 hover:-translate-y-1 cursor-pointer">
          <%= image_tag('add.png', alt: t('landing.index.chapters.add_chapter_alt'), class: 'h-14 w-auto object-contain opacity-60 group-hover:opacity-100 group-hover:scale-110 transition-all duration-300') %>
          <p class="text-white/80 font-semibold text-center text-sm group-hover:text-white"><%= t('landing.index.chapters.request_new_chapter') %></p>
          <span class="text-white/40 text-xs group-hover:text-white/60 transition-colors">via email</span>
        </div>
      </a>
    </div>
  </div>
</section>
