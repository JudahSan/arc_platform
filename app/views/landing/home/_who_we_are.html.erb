<%# ── WHO WE ARE ── %>
<section class="py-20 lg:py-28 px-6 lg:px-8 arc-section-white">
  <div class="max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <%# Left: Text content %>
      <div>
        <div class="inline-flex items-center gap-2 bg-ruby-50 text-ruby-600 rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-widest mb-4">
          <i class="fa-solid fa-heart-pulse text-xs"></i>
          <%= t('landing.index.who_we_are.subtitle') %>
        </div>
        <h2 class="arc-heading mb-6">
          <%= t('landing.index.who_we_are.title') %>
        </h2>

        <div class="space-y-5 arc-text-muted leading-relaxed">
          <p><%= t('landing.index.who_we_are.description_1') %></p>
          <p><%= t('landing.index.who_we_are.description_2') %></p>
        </div>

        <div class="mt-8">
          <%= link_to landing_about_path, class: "group arc-btn-ruby hover:scale-[1.04] transition-all duration-300" do %>
            <%= t('common.actions.read_more') %>
            <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
          <% end %>
        </div>
      </div>

      <%# Right: Images showcase + mini stats %>
      <div class="space-y-6">
        <%# Moved images from hero intro section %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="rounded-2xl overflow-hidden shadow-md border border-slate-100 hover:shadow-xl transition-all duration-300 group h-48 sm:h-52">
            <%= image_tag 'developers.jpg', class: 'w-full h-full object-cover group-hover:scale-108 transition-transform duration-500', alt: 'ARC Developers' %>
          </div>
          <div class="rounded-2xl overflow-hidden shadow-md border border-slate-100 hover:shadow-xl transition-all duration-300 group h-48 sm:h-52">
            <%= image_tag 'conference.jpg', class: 'w-full h-full object-cover group-hover:scale-108 transition-transform duration-500', alt: 'ARC Conference' %>
          </div>
        </div>

<!--        <div class="arc-pull-quote text-gray-800 dark:text-gray-100">-->
          <%#= t('landing.index.who_we_are.description_1').truncate(180) %>
<!--        </div>-->

        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-2xl p-6 text-center arc-bg-muted arc-border border hover:border-ruby-300 hover:bg-ruby-50/50 hover:-translate-y-1.5 hover:shadow-lg transition-all duration-300 cursor-default">
            <p class="text-4xl font-black text-ruby-600 mb-1">5K+</p>
            <p class="text-sm arc-text-faint font-medium"><%= t('landing.index.intro.members_count') %></p>
          </div>
          <div class="rounded-2xl p-6 text-center arc-bg-muted arc-border border hover:border-ruby-300 hover:bg-ruby-50/50 hover:-translate-y-1.5 hover:shadow-lg transition-all duration-300 cursor-default">
            <p class="text-4xl font-black text-ruby-600 mb-1"><%= Time.now.year - 2010 %>+</p>
            <p class="text-sm arc-text-faint font-medium"><%= t('landing.index.intro.years_count') %></p>
          </div>
          <div class="rounded-2xl p-6 text-center arc-bg-muted arc-border border hover:border-ruby-300 hover:bg-ruby-50/50 hover:-translate-y-1.5 hover:shadow-lg transition-all duration-300 cursor-default">
            <p class="text-4xl font-black text-ruby-600 mb-1">7+</p>
            <p class="text-sm arc-text-faint font-medium"><%= t('landing.index.who_we_are.countries_count', default: 'Countries') %></p>
          </div>
          <div class="rounded-2xl p-6 text-center arc-bg-muted arc-border border hover:border-ruby-300 hover:bg-ruby-50/50 hover:-translate-y-1.5 hover:shadow-lg transition-all duration-300 cursor-default">
            <p class="text-4xl font-black text-ruby-600 mb-1">100+</p>
            <p class="text-sm arc-text-faint font-medium"><%= t('landing.index.activities.items.events', default: 'Events Hosted') %></p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
