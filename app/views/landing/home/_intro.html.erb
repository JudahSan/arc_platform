<%# ── HERO: Building the future with Ruby in Africa ── %>
<section class="relative overflow-hidden arc-hero-landing min-h-[85vh] flex items-center justify-center py-20 lg:py-28 px-6 lg:px-8"
         style="background-image: none !important; background: transparent !important;">

  <%# Faint, Theme-Agnostic Background Image Overlay (Guaranteed Single Render) %>
  <div class="absolute inset-0 pointer-events-none bg-cover bg-center bg-no-repeat"
       style="background-image: url('<%= image_path('hero-community.jpg') %>') !important; opacity: 0.52 !important; filter: grayscale(100%) contrast(110%) !important;">
  </div>

  <%# Theme adaptation backdrop overlay %>
  <div class="absolute inset-0 pointer-events-none bg-gradient-to-b from-slate-50/90 via-slate-50/50 to-slate-50/90 dark:from-slate-950/90 dark:via-slate-950/60 dark:to-slate-950/90"></div>

  <%# Modern tech dot-matrix pattern overlay %>
  <div class="absolute inset-0 pointer-events-none opacity-20 dark:opacity-30"
       style="background-image: radial-gradient(rgba(204, 52, 45, 0.3) 1px, transparent 1px); background-size: 24px 24px;">
  </div>

  <%# Decorative glow blobs %>
  <div class="absolute -top-12 -right-12 w-[32rem] h-[32rem] rounded-full pointer-events-none filter blur-3xl opacity-40 dark:opacity-60"
       style="background: radial-gradient(circle, rgba(204,52,45,0.45) 0%, rgba(225,29,72,0.18) 50%, transparent 70%);"></div>
  <div class="absolute -bottom-12 -left-12 w-[28rem] h-[28rem] rounded-full pointer-events-none filter blur-3xl opacity-30 dark:opacity-50"
       style="background: radial-gradient(circle, rgba(244,162,97,0.35) 0%, rgba(217,119,6,0.12) 50%, transparent 70%);"></div>

  <div class="relative z-10 max-w-5xl mx-auto text-center py-12 lg:py-16">

    <%# Clickable RubyConf Africa pill badge with rubyconf.png icon %>
    <%= link_to "https://rubyconf.africa", target: "_blank", class: "inline-flex items-center gap-2.5 bg-ruby-600/10 dark:bg-white/10 hover:bg-ruby-600/20 dark:hover:bg-white/20 backdrop-blur-md border border-ruby-600/30 dark:border-white/30 rounded-full px-5 py-2 mb-8 group transition-all duration-300 shadow-sm hover:scale-[1.03]" do %>
      <%= image_tag 'rubyconf.png', class: "w-5 h-5 object-contain group-hover:scale-110 transition-transform", alt: "RubyConf Africa" %>
      <span class="text-ruby-700 dark:text-white font-bold text-xs tracking-wider uppercase">RubyConf Africa</span>
      <i class="fa-solid fa-arrow-right text-xs text-ruby-600 dark:text-amber-300 group-hover:translate-x-1 transition-transform"></i>
    <% end %>

    <%# Main Headline %>
    <h1 class="text-slate-900 dark:text-white font-extrabold leading-[1.15] mb-6 tracking-tight max-w-4xl mx-auto" style="font-size: clamp(2.4rem, 6vw, 4.2rem);">
      <span class="dark:text-transparent dark:bg-clip-text dark:bg-gradient-to-r dark:from-white dark:via-ruby-100 dark:to-amber-200">
        Building the future with Ruby in Africa
      </span>
    </h1>

    <%# Subtitle Paragraph %>
    <p class="text-slate-700 dark:text-white/80 text-lg sm:text-xl font-normal mb-10 max-w-2xl mx-auto leading-relaxed">
      A community of 5,000+ developers, entrepreneurs, and designers across East Africa united by their passion for Ruby and open-source software.
    </p>

    <%# Stats pills %>
    <div class="flex flex-wrap justify-center gap-4 mb-10">
      <div class="flex items-center gap-2.5 bg-white/70 dark:bg-white/10 backdrop-blur-md rounded-2xl px-5 py-3 border border-slate-200 dark:border-white/10 shadow-sm hover:border-ruby-300 dark:hover:border-white/25 transition-all duration-300 hover:-translate-y-1">
        <span class="text-2xl font-black text-ruby-600 dark:text-white">5K+</span>
        <span class="text-slate-600 dark:text-white/70 text-xs font-semibold uppercase tracking-wider"><%= t('landing.index.intro.members_count') %></span>
      </div>
      <div class="flex items-center gap-2.5 bg-white/70 dark:bg-white/10 backdrop-blur-md rounded-2xl px-5 py-3 border border-slate-200 dark:border-white/10 shadow-sm hover:border-ruby-300 dark:hover:border-white/25 transition-all duration-300 hover:-translate-y-1">
        <span class="text-2xl font-black text-ruby-600 dark:text-white"><%= Time.now.year - 2010 %>+</span>
        <span class="text-slate-600 dark:text-white/70 text-xs font-semibold uppercase tracking-wider"><%= t('landing.index.intro.years_count') %></span>
      </div>
      <div class="flex items-center gap-2.5 bg-white/70 dark:bg-white/10 backdrop-blur-md rounded-2xl px-5 py-3 border border-slate-200 dark:border-white/10 shadow-sm hover:border-ruby-300 dark:hover:border-white/25 transition-all duration-300 hover:-translate-y-1">
        <span class="text-2xl font-black text-ruby-600 dark:text-white">7+</span>
        <span class="text-slate-600 dark:text-white/70 text-xs font-semibold uppercase tracking-wider"><%= t('landing.index.intro.countries_count', default: "Countries") %></span>
      </div>
    </div>

    <%# CTA buttons %>
    <div class="flex flex-wrap items-center justify-center gap-5">
      <%= link_to new_user_registration_path, class: "group arc-btn-ruby text-base px-9 py-4 shadow-xl shadow-ruby-900/30 hover:scale-[1.04] transition-all duration-300 shrink-0" do %>
        <i class="fa-solid fa-users text-sm group-hover:scale-110 transition-transform"></i>
        <%= t('common.actions.join_us') %>
      <% end %>

      <%= link_to landing_about_path, class: "group inline-flex items-center justify-center gap-3 text-slate-800 dark:text-white/90 hover:text-ruby-600 dark:hover:text-white font-bold text-base border-2 border-slate-300 dark:border-white/30 hover:border-ruby-600 dark:hover:border-white/70 rounded-full hover:bg-white/90 dark:hover:bg-white/15 hover:scale-[1.04] transition-all duration-300 shadow-sm shrink-0 w-auto whitespace-nowrap backdrop-blur-sm bg-white/60 dark:bg-white/5", style: "padding-left: 1.5rem !important; padding-right: 1.5rem !important; padding-top: 1rem !important; padding-bottom: 1rem !important; display: inline-flex !important;" do %>
        <span><%= t('common.actions.read_more', default: 'Learn More') %></span>
        <i class="fa-solid fa-arrow-right text-sm group-hover:translate-x-1 transition-transform shrink-0"></i>
      <% end %>
    </div>

  </div>

  <%# Scroll hint %>
  <div class="absolute bottom-5 left-1/2 -translate-x-1/2 text-slate-400 dark:text-white/30 animate-bounce">
    <i class="fa-solid fa-chevron-down text-sm"></i>
  </div>
</section>