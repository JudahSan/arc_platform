<% content_for(:title, "Learning Materials") %>
<% content_for(:description, "A list of ruby and ruby on rails learning resources compiled by the ARC community") %>

<%# ── HERO ── %>
<div class="arc-hero-ruby py-16 px-6 lg:px-8">
  <div class="relative z-10 max-w-7xl mx-auto">
    <div class="inline-flex items-center gap-2 bg-white/15 border border-white/20 rounded-full px-4 py-1.5 text-white/80 text-xs font-bold uppercase tracking-widest mb-4">
      <i class="fa-solid fa-book-open text-xs"></i>
      Resources
    </div>
    <h1 class="text-white font-extrabold text-4xl lg:text-5xl mb-3">Learning Materials</h1>
    <p class="text-white/75 text-lg max-w-2xl">
      Community-curated resources to help you master Ruby — from beginner basics to advanced frameworks.
    </p>
  </div>
</div>

<%# ── Category Filter Pills ── %>
<div class="bg-white border-b border-gray-100 shadow-sm sticky top-16 z-40">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-4 flex flex-wrap gap-3 items-center">
    <span class="text-gray-400 text-xs font-bold uppercase tracking-widest mr-2">Jump to:</span>
    <a href="#ruby-section" class="arc-btn-outline text-xs py-1.5 px-4">
      <i class="fa-brands fa-gem text-xs"></i> Ruby
    </a>
    <a href="#tools-section" class="arc-btn-outline text-xs py-1.5 px-4">
      <i class="fa-solid fa-wrench text-xs"></i> Tools
    </a>
    <a href="#frameworks-section" class="arc-btn-outline text-xs py-1.5 px-4">
      <i class="fa-solid fa-cubes text-xs"></i> Frameworks
    </a>
  </div>
</div>

<div class="max-w-7xl mx-auto px-6 lg:px-8 py-14">

  <%# Intro %>
  <div class="arc-pull-quote mb-12 max-w-3xl">
    Take a look at our curated resources to help you get up to speed with Ruby — from the basics all the way to frameworks and tools. Want to add your own? Fork the repo and send a pull request.
  </div>

  <%# ── RUBY SECTION ── %>
  <section id="ruby-section" class="mb-16 scroll-mt-32">
    <div class="flex items-center gap-3 mb-8">
      <div class="w-10 h-10 bg-ruby-600 rounded-xl flex items-center justify-center">
        <i class="fa-brands fa-gem text-white text-lg"></i>
      </div>
      <h2 class="arc-heading text-2xl">Ruby</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% [
        { url: "http://bedford-computing.co.uk/learning/wp-content/uploads/2015/12/LittleBookOfRuby.pdf", title: "Little Book of Ruby", desc: "The fastest, easiest way to learn Ruby from the ground up.", level: "Beginner" },
        { url: "https://www.ruby-doc.org/core", title: "Ruby Core API Documentation", desc: "Official Ruby core API documentation.", level: "All Levels" },
        { url: "https://www.ruby-lang.org", title: "Download and Install Ruby", desc: "Get Ruby installed on your machine.", level: "Beginner" },
        { url: "http://ruby-doc.com/docs/ProgrammingRuby/", title: "The Pickaxe Book", desc: "Programming Ruby — the classic comprehensive guide.", level: "Intermediate" },
        { url: "http://tryruby.org/", title: "Try Ruby in Your Browser", desc: "Interactive Ruby right in your browser — no install needed.", level: "Beginner" },
        { url: "https://www.theodinproject.com/paths/full-stack-ruby-on-rails/courses/ruby", title: "The Odin Project — Ruby", desc: "Project-based Ruby learning curriculum.", level: "Beginner" },
        { url: "https://www.manning.com/books/the-well-grounded-rubyist-third-edition", title: "The Well-Grounded Rubyist", desc: "Comprehensive deep-dive into the Ruby language.", level: "Intermediate" },
        { url: "https://www.codecademy.com/learn/learn-ruby", title: "CodeAcademy Ruby Track", desc: "Learn to code Ruby interactively.", level: "Beginner" },
        { url: "http://rubykoans.com/", title: "Ruby Koans", desc: "Learn Ruby philosophy through test-driven exercises.", level: "Intermediate" },
        { url: "https://www.bloc.io/ruby-warrior/", title: "Ruby Warrior", desc: "A game to learn Ruby — based on Ryan Bates' version.", level: "Intermediate" },
        { url: "https://pine.fm/LearnToProgram/", title: "Learn To Program", desc: "Ground-level tutorial by Chris Pine.", level: "Beginner" },
        { url: "https://rubymonk.com/", title: "Ruby Monk", desc: "Interactive Ruby tutorials in your browser.", level: "Beginner" },
        { url: "https://netguru.co/blog/all-you-need-to-know-to-start-with-ruby", title: "Ruby Basic Tutorial", desc: "Everything you need to know to start with Ruby.", level: "Beginner" },
        { url: "https://leanpub.com/developing-games-with-ruby/read", title: "Developing Games With Ruby", desc: "Build games with Ruby — free to read online.", level: "Advanced" },
        { url: "https://poignant.guide/", title: "Why's Poignant Guide to Ruby", desc: "The wonderfully quirky introduction to Ruby.", level: "Beginner" },
        { url: "https://www.ruby-lang.org/en/community/", title: "Ruby Community Resources", desc: "More resources from the official Ruby community.", level: "All Levels" },
      ].each do |resource| %>
        <a href="<%= resource[:url] %>" target="_blank" rel="noopener"
           class="arc-card block p-5 group no-underline !transform hover:-translate-y-1">
          <div class="flex items-start justify-between mb-3">
            <i class="fa-solid fa-book text-ruby-400 text-lg group-hover:text-ruby-600 transition-colors"></i>
            <span class="arc-badge <%= resource[:level] == 'Beginner' ? 'arc-badge-green' : resource[:level] == 'Advanced' ? 'arc-badge-ruby' : 'arc-badge-amber' %>">
              <%= resource[:level] %>
            </span>
          </div>
          <h3 class="font-bold text-gray-900 text-sm mb-1.5 group-hover:text-ruby-600 transition-colors leading-snug">
            <%= resource[:title] %>
          </h3>
          <p class="text-gray-400 text-xs leading-relaxed line-clamp-2"><%= resource[:desc] %></p>
          <div class="mt-3 flex items-center gap-1 text-ruby-500 text-xs font-semibold">
            Visit <i class="fa-solid fa-arrow-right text-xs"></i>
          </div>
        </a>
      <% end %>
    </div>
  </section>

  <%# ── TOOLS SECTION ── %>
  <section id="tools-section" class="mb-16 scroll-mt-32">
    <div class="flex items-center gap-3 mb-8">
      <div class="w-10 h-10 bg-amber-500 rounded-xl flex items-center justify-center">
        <i class="fa-solid fa-wrench text-white text-lg"></i>
      </div>
      <h2 class="arc-heading text-2xl" style="color: #d97706;">Ruby Tools</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% [
        { url: "http://rubular.com/", title: "Rubular", desc: "Interactive Ruby regular expression editor — test your regex live.", level: "All Levels" },
      ].each do |resource| %>
        <a href="<%= resource[:url] %>" target="_blank" rel="noopener"
           class="arc-card block p-5 group no-underline !transform hover:-translate-y-1">
          <div class="flex items-start justify-between mb-3">
            <i class="fa-solid fa-terminal text-amber-500 text-lg"></i>
            <span class="arc-badge arc-badge-amber"><%= resource[:level] %></span>
          </div>
          <h3 class="font-bold text-gray-900 text-sm mb-1.5 group-hover:text-amber-600 transition-colors"><%= resource[:title] %></h3>
          <p class="text-gray-400 text-xs leading-relaxed"><%= resource[:desc] %></p>
          <div class="mt-3 flex items-center gap-1 text-amber-500 text-xs font-semibold">
            Visit <i class="fa-solid fa-arrow-right text-xs"></i>
          </div>
        </a>
      <% end %>
    </div>
  </section>

  <%# ── FRAMEWORKS SECTION ── %>
  <section id="frameworks-section" class="mb-16 scroll-mt-32">
    <div class="flex items-center gap-3 mb-8">
      <div class="w-10 h-10 bg-gray-800 rounded-xl flex items-center justify-center">
        <i class="fa-solid fa-cubes text-white text-lg"></i>
      </div>
      <h2 class="arc-heading text-2xl">Frameworks</h2>
    </div>

    <%# Jekyll %>
    <div class="mb-10">
      <h3 class="font-bold text-gray-600 text-sm uppercase tracking-widest mb-4 flex items-center gap-2">
        <span class="w-1.5 h-4 bg-ruby-600 rounded-full"></span>
        Jekyll
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% [
          { url: "http://jekyllrb.com", title: "Jekyll Official Docs", desc: "Official documentation for the Jekyll static site generator.", level: "Intermediate" },
          { url: "https://help.github.com/articles/using-jekyll-with-pages", title: "Jekyll with GitHub Pages", desc: "How to deploy Jekyll sites using GitHub Pages.", level: "Intermediate" },
        ].each do |resource| %>
          <a href="<%= resource[:url] %>" target="_blank" rel="noopener"
             class="arc-card block p-5 group no-underline !transform hover:-translate-y-1">
            <div class="flex items-start justify-between mb-3">
              <i class="fa-solid fa-j text-ruby-400 text-lg"></i>
              <span class="arc-badge arc-badge-amber"><%= resource[:level] %></span>
            </div>
            <h3 class="font-bold text-gray-900 text-sm mb-1.5 group-hover:text-ruby-600 transition-colors"><%= resource[:title] %></h3>
            <p class="text-gray-400 text-xs leading-relaxed"><%= resource[:desc] %></p>
            <div class="mt-3 flex items-center gap-1 text-ruby-500 text-xs font-semibold">Visit <i class="fa-solid fa-arrow-right text-xs"></i></div>
          </a>
        <% end %>
      </div>
    </div>

    <%# Rails %>
    <div class="mb-6">
      <h3 class="font-bold text-gray-600 text-sm uppercase tracking-widest mb-4 flex items-center gap-2">
        <span class="w-1.5 h-4 bg-ruby-600 rounded-full"></span>
        Ruby on Rails
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% [
          { url: "http://railsapps.github.io/what-is-ruby-rails.html", title: "What is Ruby on Rails?", desc: "A gentle intro to Ruby and Rails for beginners.", level: "Beginner" },
          { url: "http://www.createdbypete.com/articles/ruby-on-rails-development-setup-for-mac-osx/", title: "Rails on Mac OS X", desc: "Setup guide for Rails development on macOS.", level: "Beginner" },
          { url: "http://railsapps.github.io/installrubyonrails-ubuntu.html", title: "Rails on Ubuntu", desc: "Setup guide for Rails development on Ubuntu.", level: "Beginner" },
          { url: "http://guides.rubyonrails.org/getting_started.html", title: "Getting Started with Rails", desc: "The official Rails getting started guide.", level: "Beginner" },
          { url: "http://ruby.railstutorial.org/", title: "Ruby on Rails Tutorials", desc: "Comprehensive Rails tutorials by Michael Hartl.", level: "Intermediate" },
          { url: "http://railsforzombies.org/", title: "Rails for Zombies", desc: "Learn Rails the Zombie way — fun and interactive.", level: "Beginner" },
          { url: "http://pragprog.com/titles/rails4/agile-web-development-with-rails", title: "Agile Web Development with Rails", desc: "The pragmatic programmer's guide to Rails.", level: "Intermediate" },
          { url: "http://www.jetbrains.com/ruby/", title: "RubyMine", desc: "JetBrains' Ruby on Rails IDE.", level: "All Levels" },
          { url: "http://railscasts.com/", title: "Railscasts", desc: "Free Rails screencasts from Ryan Bates.", level: "Intermediate" },
          { url: "https://gorails.com/", title: "Go Rails", desc: "More Rails screencasts — premium and free.", level: "Intermediate" },
        ].each do |resource| %>
          <a href="<%= resource[:url] %>" target="_blank" rel="noopener"
             class="arc-card block p-5 group no-underline !transform hover:-translate-y-1">
            <div class="flex items-start justify-between mb-3">
              <i class="fa-brands fa-rails text-ruby-400 text-lg"></i>
              <span class="arc-badge <%= resource[:level] == 'Beginner' ? 'arc-badge-green' : resource[:level] == 'Advanced' ? 'arc-badge-ruby' : 'arc-badge-amber' %>">
                <%= resource[:level] %>
              </span>
            </div>
            <h3 class="font-bold text-gray-900 text-sm mb-1.5 group-hover:text-ruby-600 transition-colors"><%= resource[:title] %></h3>
            <p class="text-gray-400 text-xs leading-relaxed line-clamp-2"><%= resource[:desc] %></p>
            <div class="mt-3 flex items-center gap-1 text-ruby-500 text-xs font-semibold">Visit <i class="fa-solid fa-arrow-right text-xs"></i></div>
          </a>
        <% end %>
      </div>
    </div>
  </section>

  <%# ── CONTRIBUTE CTA ── %>
  <div class="mt-10 rounded-2xl border-2 border-dashed border-ruby-200 bg-ruby-50 p-10 text-center">
    <i class="fa-brands fa-github text-4xl text-gray-600 mb-4"></i>
    <h3 class="font-bold text-gray-800 text-xl mb-2">Know a great Ruby resource?</h3>
    <p class="text-gray-500 mb-6 max-w-md mx-auto">
      This list is community-maintained. Fork the repo, add your resource, and send us a pull request!
    </p>
    <a href="https://github.com/rubycommunity-africa" target="_blank" rel="noopener" class="arc-btn-ruby">
      <i class="fa-brands fa-github text-sm"></i>
      Contribute on GitHub
    </a>
  </div>
</div>
