<% content_for :title, t('events.index.page_title') %>
<% content_for(:description, t('events.index.page_description')) %>

<%# ── HERO STRIP ── %>
<div class="arc-hero-ruby py-14 px-6 lg:px-8">
  <div class="relative z-10 max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div>
      <div class="inline-flex items-center gap-2 bg-white/15 border border-white/20 rounded-full px-4 py-1.5 text-white/80 text-xs font-bold uppercase tracking-widest mb-4">
        <i class="fa-regular fa-calendar text-xs"></i>
        Community Events
      </div>
      <h1 class="text-white font-extrabold text-4xl lg:text-5xl mb-2"><%= t('events.index.title') %></h1>
      <p class="text-white/75 text-base max-w-xl"><%= t('events.index.page_description') %></p>
    </div>
    <% if can? :create, Event %>
      <%= link_to new_event_path, class: "arc-btn-ruby self-start md:self-center flex-shrink-0 shadow-lg" do %>
        <i class="fa-solid fa-plus text-sm"></i>
        <%= t('events.index.create_event') %>
      <% end %>
    <% end %>
  </div>
</div>

<%# ── SEARCH SECTION ── %>
<div class="arc-section-white border-b arc-border shadow-sm">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-6">
    <%= form_with url: events_path, method: :get, data: { controller: "event-search", turbo_frame: "events_list", action: "input->event-search#search change->event-search#search" }, class: 'w-full' do %>
      <div class="flex gap-3 flex-wrap items-center">
        <div class="relative flex-1 min-w-[260px]">
          <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
          <%= text_field_tag :query, params[:query],
              placeholder: t('events.index.search_placeholder'),
              class: 'w-full h-12 pl-10 pr-4 rounded-xl border border-gray-200 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-ruby-500/30 focus:border-ruby-500 bg-gray-50 text-sm transition-all',
              data: { event_search_target: "query" } %>
        </div>

        <div class="relative">
          <%= select_tag :date,
              options_for_select([
                [t('events.index.any_date'), ''],
                [t('events.index.today'), 'today'],
                [t('events.index.this_week'), 'this_week'],
                [t('events.index.this_month'), 'this_month'],
                [t('events.index.upcoming'), 'upcoming'],
                [t('events.index.past'), 'past']
              ], params[:date]),
              class: 'h-12 pl-4 pr-10 rounded-xl border border-gray-200 text-gray-700 focus:outline-none focus:ring-2 focus:ring-ruby-500/30 focus:border-ruby-500 bg-gray-50 text-sm appearance-none cursor-pointer',
              data: { event_search_target: "date" } %>
          <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none"></i>
        </div>

        <div class="relative">
          <%= select_tag :country,
              options_for_select([[t('events.index.all_countries'), '']] + @countries.map { |c| [c.name, c.id] }, params[:country]),
              class: 'h-12 pl-4 pr-10 rounded-xl border border-gray-200 text-gray-700 focus:outline-none focus:ring-2 focus:ring-ruby-500/30 focus:border-ruby-500 bg-gray-50 text-sm appearance-none cursor-pointer',
              data: { event_search_target: "country" } %>
          <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none"></i>
        </div>

        <button type="submit" class="arc-btn-ruby h-12 px-6 text-sm flex-shrink-0">
          <i class="fa-solid fa-magnifying-glass text-xs"></i>
          Search
        </button>
      </div>
    <% end %>
  </div>
</div>

<%# ── EVENTS GRID ── %>
<div class="max-w-7xl mx-auto px-6 lg:px-8 py-12 arc-bg-base">
  <%= turbo_frame_tag "events_list" do %>
    <section>
      <% if @events.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7">
          <% @events.each do |event| %>
            <div class="arc-card group">
              <%# Image area with date badge %>
              <%= link_to event_path(event), data: { turbo_frame: "_top" } do %>
                <div class="relative overflow-hidden" style="height: 200px;">
                  <% if event.image.attached? %>
                    <%= image_tag event.image, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500", alt: event.title %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center" style="background: linear-gradient(135deg, #CC342D, #8b1219);">
                      <i class="fa-regular fa-calendar text-white/30 text-5xl"></i>
                    </div>
                  <% end %>

                  <%# Dark gradient overlay %>
                  <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 60%);"></div>

                  <%# Date badge %>
                  <div class="arc-date-badge">
                    <span class="day"><%= event.start_datetime.strftime("%-d") %></span>
                    <span class="month"><%= event.start_datetime.strftime("%b") %></span>
                  </div>

                  <%# Payment badge %>
                  <% if event.payment_status == 'free' %>
                    <div class="absolute top-3 right-3">
                      <span class="arc-badge arc-badge-green text-xs">Free</span>
                    </div>
                  <% elsif event.payment_status == 'paid' %>
                    <div class="absolute top-3 right-3">
                      <span class="arc-badge arc-badge-amber text-xs"><%= number_to_currency(event.price_cents / 100.0) %></span>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <%# Card body %>
              <div class="p-5">
                <%= link_to event_path(event), data: { turbo_frame: "_top" } do %>
                  <h3 class="font-bold arc-text-base text-base leading-snug mb-2 group-hover:text-ruby-600 transition-colors line-clamp-2"><%= event.title %></h3>
                <% end %>

                <p class="text-sm arc-text-faint mb-3">
                  <i class="fa-regular fa-clock text-ruby-400 mr-1"></i>
                  <%= event.start_datetime.strftime("%I:%M %p") %> – <%= event.end_datetime.strftime("%I:%M %p %Z") %>
                </p>

                <% country_name = event.chapter&.country&.name %>
                <% if country_name %>
                  <div class="flex items-center gap-1.5">
                    <% if country_icon(country_name) %>
                      <%= image_tag country_icon(country_name), alt: country_name, class: "w-4 h-4 object-contain rounded-sm" %>
                    <% end %>
                    <span class="text-xs text-gray-500 font-medium"><%= country_name %></span>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <%# Empty state %>
        <div class="text-center py-24">
          <div class="w-20 h-20 bg-ruby-50 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fa-regular fa-calendar-xmark text-ruby-400 text-3xl"></i>
          </div>
          <h3 class="arc-text-base font-bold text-xl mb-2"><%= t('events.index.no_events') %></h3>
          <p class="arc-text-xfaint mb-8">Check back soon — the community is always organizing something!</p>
          <% if can? :create, Event %>
            <%= link_to new_event_path, class: "arc-btn-ruby" do %>
              <i class="fa-solid fa-plus text-sm"></i>
              Create the First Event
            <% end %>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
