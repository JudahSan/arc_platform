<% content_for(:title, t('chapters.index.page_title')) %>
<% content_for(:description, t('chapters.index.page_description')) %>
<% require 'digest' %>

<%# ── HERO STRIP ── %>
<div class="arc-hero-ruby py-14 px-6 lg:px-8">
  <div class="relative z-10 max-w-7xl mx-auto">
    <div class="inline-flex items-center gap-2 bg-white/15 border border-white/20 rounded-full px-4 py-1.5 text-white/80 text-xs font-bold uppercase tracking-widest mb-4">
      <i class="fa-solid fa-map-pin text-xs"></i>
      <%= t('chapters.index.mini_title') %>
    </div>
    <h1 class="text-white font-extrabold text-4xl lg:text-5xl mb-3"><%= t('chapters.index.title') %></h1>
    <p class="text-white/70 text-lg max-w-xl"><%= t('chapters.index.page_description') %>Find your local Ruby community and connect with developers in your city.</p>
  </div>
</div>

<%# ── FILTER ── %>
<div class="arc-section-white border-b arc-border shadow-sm">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-4">
    <div class="dropdown">
      <% selected_country = @countries.find { |c| c.id.to_s == @country_param } %>
      <label tabindex="0" class="arc-btn-outline text-sm cursor-pointer gap-2 inline-flex">
        <% if selected_country && country_icon(selected_country.name) %>
          <%= image_tag country_icon(selected_country.name), alt: selected_country.name, class: "w-5 h-4 object-contain" %>
        <% else %>
          <i class="fa-solid fa-globe text-sm"></i>
        <% end %>
        <%= selected_country&.name || 'All Countries' %>
        <i class="fa-solid fa-chevron-down text-xs"></i>
      </label>
      <ul tabindex="0" class="dropdown-content menu p-2 shadow-xl bg-white border border-gray-100 rounded-2xl w-56 mt-2 z-20">
        <li><%= link_to "All Countries", chapters_path, class: "rounded-lg text-sm #{@country_param.blank? ? 'font-bold text-ruby-600' : ''}" %></li>
        <% @countries.each do |country| %>
          <li>
            <%= link_to chapters_path(country: country.id), class: "rounded-lg flex items-center gap-2 text-sm #{@country_param == country.id.to_s ? 'font-bold text-ruby-600' : ''}" do %>
              <% if country_icon(country.name) %>
                <%= image_tag country_icon(country.name), alt: country.name, class: "w-5 h-4 object-contain" %>
              <% end %>
              <span><%= country.name %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>

<%# ── CHAPTERS GRID ── %>
<div class="max-w-7xl mx-auto px-6 lg:px-8 py-12 arc-bg-base">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7">
    <% @chapters.each do |chapter| %>
      <div class="arc-card group cursor-pointer">
        <%# Image area %>
        <div class="relative overflow-hidden" style="height: 200px;">
          <%= image_tag(chapter.image.attached? ? chapter.image.url : image_path('chapter.jpg'),
              alt: chapter.name,
              class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500") %>
          <div class="absolute inset-0 bg-gradient-to-t from-gray-950/70 via-transparent to-transparent group-hover:from-ruby-900/75 transition-all duration-300"></div>
          <div class="absolute bottom-4 left-4 right-4">
            <h3 class="text-white font-bold text-xl group-hover:text-ruby-200 transition-colors"><%= chapter.name %></h3>
          </div>
        </div>
        <%# Card footer %>
        <div class="p-4 flex items-center justify-between">
          <div class="flex items-center gap-2 text-gray-500 text-sm">
            <i class="fa-solid fa-users text-ruby-400 text-xs"></i>
            <span>Members</span>
          </div>
          <span class="arc-badge arc-badge-ruby">Active</span>
        </div>
      </div>
    <% end %>
  </div>

  <% if @country_param.present? %>
    <%# Featured Members — hidden by design but structure preserved %>
    <div class="mt-16" style="display: none">
      <h2 class="text-2xl font-bold mb-6">Featured members</h2>
      <% if @featured_members.present? %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <% @featured_members.each do |member| %>
            <div class="arc-card p-6">
              <% gravatar = "https://www.gravatar.com/avatar/#{Digest::MD5.hexdigest(member.email.to_s.downcase)}?s=120&d=identicon" %>
              <img src="<%= gravatar %>" alt="<%= member.name %>" class="w-20 h-20 rounded-full object-cover mb-3 border-2 border-ruby-100">
              <p class="font-semibold text-gray-900"><%= member.name %></p>
              <p class="text-sm text-gray-500">Member of the community</p>
              <% if member.github_username.present? %>
                <a href="https://github.com/<%= member.github_username %>" target="_blank" rel="noopener" class="text-ruby-600 text-sm hover:underline mt-2 inline-flex items-center gap-1">
                  <i class="fa-brands fa-github text-sm"></i> GitHub
                </a>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-ruby-50 rounded-xl p-6 text-gray-600">No featured members found for this country.</div>
      <% end %>
    </div>

    <%# Upcoming Events from that country — hidden by design but structure preserved %>
    <div class="mt-16" style="display: none">
      <h2 class="text-2xl font-bold mb-6">Upcoming events</h2>
      <% if @upcoming_events.present? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @upcoming_events.each do |event| %>
            <div class="arc-card group">
              <%= link_to event_path(event) do %>
                <div class="relative overflow-hidden" style="height: 180px;">
                  <% if event.image.attached? %>
                    <%= image_tag event.image, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500", alt: event.title %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center" style="background: linear-gradient(135deg, #CC342D, #8b1219);">
                      <i class="fa-regular fa-calendar text-white/30 text-4xl"></i>
                    </div>
                  <% end %>
                  <div class="arc-date-badge">
                    <span class="day"><%= event.start_datetime.strftime("%-d") %></span>
                    <span class="month"><%= event.start_datetime.strftime("%b") %></span>
                  </div>
                </div>
              <% end %>
              <div class="p-4">
                <h3 class="font-bold text-gray-900 text-sm line-clamp-2 mb-1"><%= event.title %></h3>
                <p class="text-xs text-gray-500"><%= event.start_datetime.strftime("%B %d, %Y") %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-ruby-50 rounded-xl p-6 text-gray-600">No upcoming events found for this country.</div>
      <% end %>
    </div>
  <% end %>
</div>
