<!-- Header Section -->
<div class="bg-white border-b border-gray-200 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Chapters</h1>
    <p class="text-gray-600 text-lg">Join your local chapter and connect with Ruby developers in your region.</p>
  </div>
</div>

<!-- Chapters Grid -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
    <div class="card bg-white shadow">
      <div class="card-body">
        <h2 class="card-title text-xl"><%= @chapter.name %> Chapter</h2>
        <p class="text-gray-600"><%= @chapter.location.presence || @chapter.country&.name || 'Location' %></p>
        <div class="divider my-2"></div>
        <p class="text-2xl font-bold text-black-600"><%= @member_count %>+ Members</p>
        <div class="card-actions justify-between pt-4">
          <button class="btn btn-sm btn-outline">View Members</button>
          <button class="btn btn-sm btn-red">Learn More</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Chapter Members Section -->
  <div class="bg-white rounded-lg shadow-md p-8 mb-12">
    <h2 class="text-2xl font-bold mb-8">Chapter Leaders & Organizers</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <% if @chapter.users.any? %>
        <% @chapter.users.limit(4).each do |user| %>
          <div class="border-l-4 border-blue-500 pl-6 py-4">
            <p class="font-semibold text-lg text-gray-900 mb-2"><%= user.name %></p>
            <p class="text-gray-600 text-sm mb-4"><%= user.email %></p>
            <div class="flex gap-4">
              <% if user.github_username.present? %>
                <a href="https://github.com/<%= user.github_username %>" class="link link-red text-sm">github</a>
              <% end %>
              <a href="#" class="link link-red text-sm">linkedin</a>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Chapter Events -->
  <div class="mb-12">
    <h2 class="text-2xl font-bold mb-6">Upcoming Chapter Events</h2>
    <% if @upcoming_events.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @upcoming_events.each do |event| %>
          <%= link_to event_path(event), class: "card card-compact bg-white shadow hover:shadow-lg transition-shadow" do %>
            <div class="card-body">
              <h3 class="card-title text-lg"><%= event.title %></h3>
              <div class="space-y-2 text-sm text-gray-600">
                <p><strong><%= event.start_datetime.strftime("%B %d, %Y") %></strong></p>
                <p><%= event.location_name || "Location TBA" %></p>
                <p><%= event.start_datetime.strftime("%I:%M %p") %> - <%= event.end_datetime.strftime("%I:%M %p") %></p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="bg-blue-50 rounded-lg p-8">
        <p class="text-gray-600">No upcoming events scheduled at this time. Check back soon!</p>
      </div>
    <% end %>
  </div>

  <!-- Past Events -->
  <% if @past_events.present? && @past_events.any? %>
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-6">Past Chapter Events</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @past_events.each do |event| %>
          <%= link_to event_path(event), class: "card card-compact bg-white shadow hover:shadow-lg transition-shadow" do %>
            <div class="card-body">
              <h3 class="card-title text-lg"><%= event.title %></h3>
              <div class="space-y-2 text-sm text-gray-600">
                <p><strong><%= event.start_datetime.strftime("%B %d, %Y") %></strong></p>
                <p><%= event.location_name || "Location TBA" %></p>
                <p><%= event.start_datetime.strftime("%I:%M %p") %> - <%= event.end_datetime.strftime("%I:%M %p") %></p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Start Discussion -->
<!--  <div class="bg-blue-50 rounded-lg p-8 mt-12">-->
<!--    <h3 class="text-xl font-bold mb-2">Start a discussion in your chapter</h3>-->
<!--    <p class="text-gray-600 mb-4">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.</p>-->
<!--    <button class="btn btn-red">Start a discussion</button>-->
<!--  </div>-->
</div>
