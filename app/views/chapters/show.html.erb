<%# ── CHAPTER HERO ── %>
<div class="arc-hero-ruby py-16 px-6 lg:px-8">
  <div class="relative z-10 max-w-7xl mx-auto">
    <div class="inline-flex items-center gap-2 bg-white/15 border border-white/20 rounded-full px-4 py-1.5 text-white/80 text-xs font-bold uppercase tracking-widest mb-4">
      <i class="fa-solid fa-map-pin text-xs"></i>
      <%= t('chapters.show.title') %>
    </div>
    <h1 class="text-white font-extrabold text-4xl lg:text-5xl mb-2"><%= @chapter.name %> <%= t('chapters.show.chapter') %></h1>
    <p class="text-white/70 text-lg"><%= @chapter.location.presence || @chapter.country&.name || 'East Africa' %></p>

    <%# Stats strip %>
    <div class="flex flex-wrap gap-4 mt-8">
      <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-xl px-5 py-3 border border-white/15">
        <i class="fa-solid fa-users text-ruby-300 text-lg"></i>
        <div>
          <p class="text-white font-bold text-xl leading-none"><%= @member_count %>+</p>
          <p class="text-white/60 text-xs mt-0.5"><%= t('chapters.show.members') %></p>
        </div>
      </div>
      <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-xl px-5 py-3 border border-white/15">
        <i class="fa-regular fa-calendar text-ruby-300 text-lg"></i>
        <div>
          <p class="text-white font-bold text-xl leading-none"><%= @upcoming_events.count %></p>
          <p class="text-white/60 text-xs mt-0.5"><%= t('chapters.show.upcoming_events') %></p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="max-w-7xl mx-auto px-6 lg:px-8 py-12 arc-bg-base">

  <%# ── ORGANIZERS ── %>
  <div class="mb-14">
    <div class="flex items-center gap-3 mb-6">
      <i class="fa-solid fa-star text-ruby-600"></i>
      <h2 class="font-bold arc-text-base text-2xl"><%= t('chapters.show.leaders_organizers') %></h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <% if @chapter.users.any? %>
        <% @chapter.users.limit(4).each do |user| %>
          <div class="arc-card p-6 flex items-start gap-4 !transform-none !translate-y-0">
            <div class="w-12 h-12 rounded-full bg-ruby-600 flex items-center justify-center flex-shrink-0">
              <span class="text-white font-bold text-lg"><%= user.name.to_s.first.upcase %></span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-bold arc-text-base text-base"><%= user.name %></p>
              <p class="arc-text-faint text-sm truncate"><%= user.email %></p>
              <div class="flex gap-3 mt-2">
                <% if user.github_username.present? %>
                  <a href="https://github.com/<%= user.github_username %>" target="_blank" rel="noopener" class="text-ruby-600 hover:text-ruby-700 text-sm flex items-center gap-1 font-medium">
                    <i class="fa-brands fa-github text-sm"></i> GitHub
                  </a>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ── UPCOMING EVENTS ── %>
  <div class="mb-14">
    <div class="flex items-center gap-3 mb-6">
      <i class="fa-regular fa-calendar-check text-ruby-600"></i>
      <h2 class="font-bold arc-text-base text-2xl"><%= t('chapters.show.upcoming_events') %></h2>
    </div>
    <% if @upcoming_events.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @upcoming_events.each do |event| %>
          <div class="arc-card group">
            <%= link_to event_path(event) do %>
              <div class="relative overflow-hidden" style="height: 180px;">
                <% if event.image.attached? %>
                  <%= image_tag event.image, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500", alt: event.title %>
                <% else %>
                  <div class="w-full h-full flex items-center justify-center" style="background: linear-gradient(135deg, #CC342D, #8b1219);">
                    <i class="fa-regular fa-calendar text-white/30 text-4xl"></i>
                  </div>
                <% end %>
                <div class="absolute inset-0 bg-gradient-to-t from-gray-950/50 to-transparent"></div>
                <div class="arc-date-badge">
                  <span class="day"><%= event.start_datetime.strftime("%-d") %></span>
                  <span class="month"><%= event.start_datetime.strftime("%b") %></span>
                </div>
                <% if event.payment_status == 'free' %>
                  <div class="absolute top-3 right-3"><span class="arc-badge arc-badge-green"><%= t('chapters.show.free') %></span></div>
                <% elsif event.payment_status == 'paid' %>
                  <div class="absolute top-3 right-3"><span class="arc-badge arc-badge-amber"><%= t('chapters.show.paid') %></span></div>
                <% end %>
              </div>
            <% end %>
            <div class="p-5">
              <%= link_to event_path(event) do %>
                <h3 class="font-bold text-gray-900 text-sm line-clamp-2 mb-2 group-hover:text-ruby-600 transition-colors"><%= event.title %></h3>
              <% end %>
              <p class="text-xs text-gray-500 mb-1"><%= event.start_datetime.strftime("%B %d, %Y") %></p>
              <% if event.location_name.present? %>
                <div class="flex items-center gap-1.5 text-xs text-gray-400">
                  <i class="fa-solid fa-location-dot text-ruby-400"></i>
                  <span><%= event.location_name %></span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-ruby-50 rounded-2xl p-8 text-center">
        <i class="fa-regular fa-calendar-xmark text-ruby-300 text-3xl mb-3"></i>
        <p class="text-gray-600"><%= t('chapters.show.no_upcoming_events') %></p>
      </div>
    <% end %>
  </div>

  <%# ── PAST EVENTS ── %>
  <% if @past_events.present? && @past_events.any? %>
    <div class="mb-14">
      <div class="flex items-center gap-3 mb-6">
        <i class="fa-solid fa-clock-rotate-left text-gray-400"></i>
        <h2 class="font-bold text-gray-600 text-xl"><%= t('chapters.show.past_events') %></h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @past_events.each do |event| %>
          <div class="arc-card group opacity-80 hover:opacity-100 transition-opacity">
            <%= link_to event_path(event) do %>
              <div class="relative overflow-hidden" style="height: 160px;">
                <% if event.image.attached? %>
                  <%= image_tag event.image, class: "w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500", alt: event.title %>
                <% else %>
                  <div class="w-full h-full bg-gray-300 flex items-center justify-center">
                    <i class="fa-regular fa-calendar text-gray-500 text-3xl"></i>
                  </div>
                <% end %>
              </div>
            <% end %>
            <div class="p-4">
              <h3 class="font-semibold text-gray-700 text-sm line-clamp-2 mb-1"><%= event.title %></h3>
              <p class="text-xs text-gray-400"><%= event.start_datetime.strftime("%B %d, %Y") %></p>
              <% if event.location_name.present? %>
                <div class="flex items-center gap-1.5 text-xs text-gray-400 mt-1">
                  <i class="fa-solid fa-location-dot text-xs"></i>
                  <span><%= event.location_name %></span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ── FEATURED PROJECTS ── %>
  <% if @featured_projects&.any? %>
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <i class="fa-solid fa-code text-ruby-600"></i>
        <h2 class="font-bold arc-text-base text-2xl"><%= t('chapters.show.featured_projects') %></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @featured_projects.each do |project| %>
          <%= link_to project_path(project), class: "arc-card block p-6 no-underline" do %>
            <h3 class="font-bold text-gray-900 text-lg mb-2 group-hover:text-ruby-600"><%= project.name %></h3>
            <% if project.intro.present? %>
              <p class="text-sm text-gray-500 line-clamp-2"><%= project.intro %></p>
            <% end %>
            <div class="mt-4 flex items-center gap-1 text-ruby-600 text-xs font-semibold">
              View project <i class="fa-solid fa-arrow-right text-xs"></i>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
