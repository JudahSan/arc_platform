<footer class="arc-footer mt-24 border-t border-gray-200 dark:border-gray-800" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 pt-16 pb-10">

    <%# ── Top Grid ── %>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">

      <%# Column 1: Logo + tagline %>
      <div class="md:col-span-1">
        <%= link_to root_path do %>
          <%= image_tag('arc_logo_coloured.png', alt: "RubyCommunity Africa Logo", class: 'w-36 mb-4') %>
        <% end %>
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
          Building Africa's Ruby ecosystem, one developer at a time. 🌍
        </p>
        <p class="text-xs text-gray-500 dark:text-gray-500 mt-3">
          Since 2010 · MINASWAN
        </p>
      </div>

      <%# Column 2: Quick Links %>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-4">Community</h3>
        <ul class="space-y-2.5 text-sm">
          <li><%= link_to t('footer.home'), root_path, class: "text-gray-600 dark:text-gray-400 hover:text-ruby-600 dark:hover:text-ruby-400 transition-colors" %></li>
          <% if FeatureFlag.find_by(name: 'events').try(:enabled) %>
            <li><%= link_to t('footer.events'), events_path, class: "text-gray-600 dark:text-gray-400 hover:text-ruby-600 dark:hover:text-ruby-400 transition-colors" %></li>
          <% end %>
          <li><%= link_to t('footer.chapters'), chapters_path, class: "text-gray-600 dark:text-gray-400 hover:text-ruby-600 dark:hover:text-ruby-400 transition-colors" %></li>
          <% if FeatureFlag.find_by(name: 'projects')&.enabled %>
            <li><%= link_to t('footer.projects'), projects_path, class: "text-gray-600 dark:text-gray-400 hover:text-ruby-600 dark:hover:text-ruby-400 transition-colors" %></li>
          <% end %>
          <% if FeatureFlag.find_by(name: 'learning_materials')&.enabled %>
            <li><%= link_to t('footer.learning_materials'), learning_materials_path, class: "text-gray-600 dark:text-gray-400 hover:text-ruby-600 dark:hover:text-ruby-400 transition-colors" %></li>
          <% end %>
        </ul>
      </div>

      <%# Column 3: Resources %>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-4">Resources</h3>
        <ul class="space-y-2.5 text-sm">
          <li><%= link_to t('footer.about'), landing_about_path, class: "text-gray-600 dark:text-gray-400 hover:text-ruby-600 dark:hover:text-ruby-400 transition-colors" %></li>
          <li><%= link_to "Built with Ruby", built_with_ruby_path, class: "text-gray-600 dark:text-gray-400 hover:text-ruby-600 dark:hover:text-ruby-400 transition-colors" %></li>
          <li><%= link_to t('footer.sponsor'), 'mailto:organisers@rubycommunity.africa', class: "text-gray-600 dark:text-gray-400 hover:text-ruby-600 dark:hover:text-ruby-400 transition-colors" %></li>
          <% if FeatureFlag.find_by(name: 'members').try(:enabled) %>
            <li><%= link_to t('footer.members'), '#', class: "text-gray-600 dark:text-gray-400 hover:text-ruby-600 dark:hover:text-ruby-400 transition-colors" %></li>
          <% end %>
          <li><%= link_to "Code of Conduct", "https://rubycommunity.africa/code-of-conduct", target: "_blank", class: "text-gray-600 dark:text-gray-400 hover:text-ruby-600 dark:hover:text-ruby-400 transition-colors" %></li>
        </ul>
      </div>

      <%# Column 4: Social links %>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-4"><%= t('footer.connect') %></h3>
        <div class="flex flex-wrap gap-3">
          <% socials.each do |social| %>
            <% if social[:show] === true %>
              <%= link_to social[:link], target: "_blank", rel: "noopener",
                  class: "w-10 h-10 flex items-center justify-center rounded-full bg-gray-200 dark:bg-gray-800 hover:bg-ruby-600 dark:hover:bg-ruby-600 text-gray-600 dark:text-gray-400 hover:text-white dark:hover:text-white transition-all duration-200 hover:scale-110" do %>
                <%= image_tag social[:image], alt: social[:alt], class: "w-5 h-5 object-contain" %>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <div class="mt-6 space-y-1.5 text-sm">
          <a href="mailto:organisers@rubycommunity.africa" class="flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-ruby-600 dark:hover:text-ruby-400 transition-colors">
            <i class="fa-regular fa-envelope text-xs"></i>
            <span>organisers@rubycommunity.africa</span>
          </a>
        </div>
      </div>
    </div>

    <%# ── Divider ── %>
    <div class="border-t border-gray-200 dark:border-gray-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-gray-500 dark:text-gray-500">
        <%= t('footer.copyright', year: Date.today.year) %>
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-500 flex items-center gap-1">
        Made with <span class="text-ruby-600 dark:text-ruby-500 text-base">❤️</span> in Africa by the community
      </p>
    </div>
  </div>
</footer>
