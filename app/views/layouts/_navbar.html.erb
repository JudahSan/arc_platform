<nav class="sticky top-0 z-50" id="main-navbar" data-controller="theme">
  <div class="arc-navbar-bg border-b backdrop-blur-md transition-colors duration-300">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">

      <%# ── Logo (Dual Mode Toggle for DaisyUI data-theme) ── %>
      <%= link_to root_path,
                  aria: { label: t('navigation.community_name') },
                  class: "flex-shrink-0 flex items-center" do %>

        <%# Full-Color Logo (Visible in Light Mode / Default) %>
        <%= image_tag "arc_logo_coloured.png",
                      alt: "RubyCommunity Africa Logo",
                      class: "h-9 w-auto sm:h-8 block [html[data-theme='dark']_&]:hidden" %>

        <%# Gray/White Logo (Visible only when data-theme='dark') %>
        <%= image_tag "arc_dark_gray_logo.png",
                      alt: "RubyCommunity Africa Logo",
                      class: "h-9 w-auto sm:h-8 hidden [html[data-theme='dark']_&]:block brightness-0 invert" %>

      <% end %>

      <%# ── Desktop nav links ── %>
      <nav class="hidden md:flex items-center gap-4 lg:gap-6 flex-shrink min-w-0">
        <%= link_to t('navigation.home'), root_path,
                    class: "arc-nav-link whitespace-nowrap flex-shrink-0 text-sm sm:text-base #{current_page?(root_path) ? 'active' : ''}" %>

        <%= link_to t('navigation.about'), landing_about_path,
                    class: "arc-nav-link whitespace-nowrap flex-shrink-0 text-sm sm:text-base #{current_page?(landing_about_path) ? 'active' : ''}" %>

        <%# ── Community Dropdown ── %>
        <div class="dropdown dropdown-hover">
          <button tabindex="0" class="arc-nav-link whitespace-nowrap flex-shrink-0 text-sm sm:text-base flex items-center gap-1">
            <%= t('navigation.community') %>
            <i class="fa-solid fa-chevron-down text-[10px]"></i>
          </button>
          <ul tabindex="0" class="dropdown-content menu p-2 shadow-lg bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl w-48">
            <li><%= link_to t('navigation.events'), events_path, class: "text-sm" %></li>
            <li><%= link_to t('navigation.chapters'), chapters_path, class: "text-sm" %></li>
            <li><%= link_to t('navigation.projects'), projects_path, class: "text-sm" %></li>
            <li><%= link_to t('navigation.code_of_conduct'), landing_code_of_conduct_path, class: "text-sm" %></li>
          </ul>
        </div>

        <%# ── Resources Dropdown ── %>
        <div class="dropdown dropdown-hover">
          <button tabindex="0" class="arc-nav-link whitespace-nowrap flex-shrink-0 text-sm sm:text-base flex items-center gap-1">
            <%= t('navigation.resources') %>
            <i class="fa-solid fa-chevron-down text-[10px]"></i>
          </button>
          <ul tabindex="0" class="dropdown-content menu p-2 shadow-lg bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl w-48">
            <li><%= link_to t('navigation.learning_materials'), learning_materials_path, class: "text-sm" %></li>
            <li><%= link_to t('navigation.built_with_ruby'), built_with_ruby_path, class: "text-sm" %></li>
          </ul>
        </div>
      </nav>

      <%# ── Right side actions ── %>
      <div class="hidden md:flex items-center gap-2 flex-shrink-0">

        <%# Dark mode toggle — uses data-theme-moon / data-theme-sun %>
        <button data-action="click->theme#toggle"
                class="w-9 h-9 flex items-center justify-center rounded-full text-slate-600 hover:text-ruby-600 hover:bg-slate-100 dark:hover:bg-white/10 transition-all duration-200 border border-transparent hover:border-slate-200 dark:hover:border-white/20"
                title="Toggle dark mode" aria-label="Toggle dark mode">
          <i data-theme-moon class="fa-solid fa-moon text-sm text-slate-900 dark:text-slate-600"></i>
          <i data-theme-sun class="fa-solid fa-sun text-sm text-amber-400" style="display:none"></i>
        </button>

        <% if user_signed_in? %>
          <% if current_user.organization_admin? %>
            <div class="dropdown dropdown-end">
              <button tabindex="0" class="w-9 h-9 flex items-center justify-center rounded-full text-gray-500 hover:text-ruby-600 hover:bg-gray-100/80 transition-colors" title="Settings">
                <i class="fa-solid fa-gear text-sm"></i>
              </button>
              <ul tabindex="0" class="menu dropdown-content p-2 shadow-lg bg-white border border-gray-100 rounded-xl w-48 mt-3">
                <li class="menu-title px-3 py-1 text-xs text-gray-400 font-semibold uppercase tracking-wider"><%= t('navigation.settings') %></li>
                <li><%= link_to t('navigation.countries'), countries_path, class: "text-sm" %></li>
                <li><%= link_to t('navigation.chapters'), chapters_path, class: "text-sm" %></li>
              </ul>
            </div>
          <% end %>

          <div class="dropdown dropdown-end">
            <button tabindex="0"
                    class="w-9 h-9 flex items-center justify-center rounded-full bg-red-600 text-white hover:bg-red-700 transition-colors font-bold text-sm flex-shrink-0 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
                    title="<%= current_user.name %>">
              <%= current_user.name.to_s.first.upcase %>
            </button>
            <ul tabindex="0" class="menu dropdown-content p-2 shadow-lg bg-white border border-gray-100 rounded-xl w-52 mt-3">
              <li class="menu-title px-3 py-1 text-xs text-gray-400 truncate max-w-full"><%= current_user.email %></li>
              <li><%= link_to t('navigation.update_profile'), edit_user_registration_path, class: "text-sm" %></li>
              <li>
                <%= button_to t('navigation.sign_out'), destroy_user_session_path, method: :delete,
                              class: "text-sm text-red-600 font-medium w-full text-left px-3 py-2 hover:bg-red-50 rounded-lg" %>
              </li>
            </ul>
          </div>

        <% else %>
          <%= link_to t('navigation.sign_in'), new_user_session_path,
                      class: "arc-nav-link text-sm font-semibold whitespace-nowrap" %>
        <% end %>
      </div>

      <%# ── Mobile hamburger ── %>
      <div class="md:hidden flex items-center gap-2">
        <button data-action="click->theme#toggle"
                class="w-9 h-9 flex items-center justify-center rounded-full text-slate-600 hover:text-ruby-600 hover:bg-slate-100 dark:hover:bg-white/10 transition-all duration-200">
          <i data-theme-moon class="fa-solid fa-moon text-sm text-slate-900 dark:text-slate-600"></i>
          <i data-theme-sun class="fa-solid fa-sun text-sm text-amber-400" style="display:none"></i>
        </button>

        <div class="dropdown dropdown-end">
          <label tabindex="0" class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-gray-100/80 cursor-pointer transition-colors">
            <svg class="h-5 w-5 text-gray-700" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
            </svg>
          </label>
          <ul tabindex="0" class="menu menu-compact dropdown-content mt-3 p-3 shadow-xl bg-white border border-gray-100 rounded-2xl w-64 gap-1">
            <li><%= link_to t('navigation.home'), root_path, class: "rounded-xl font-medium #{current_page?(root_path) ? 'text-ruby-600 bg-ruby-50' : ''}" %></li>
            <li><%= link_to t('navigation.about'), landing_about_path, class: "rounded-xl font-medium #{current_page?(landing_about_path) ? 'text-ruby-600 bg-ruby-50' : ''}" %></li>

            <% if FeatureFlag.find_by(name: 'events').try(:enabled) %>
              <li><%= link_to t('navigation.events'), events_path, class: "rounded-xl font-medium" %></li>
            <% end %>

            <li><%= link_to t('navigation.chapters'), chapters_path, class: "rounded-xl font-medium" %></li>

            <% if FeatureFlag.find_by(name: 'projects')&.enabled %>
              <li><%= link_to t('navigation.projects'), projects_path, class: "rounded-xl font-medium" %></li>
            <% end %>

            <% if FeatureFlag.find_by(name: 'learning_materials')&.enabled %>
              <li><%= link_to t('navigation.learning_materials'), learning_materials_path, class: "rounded-xl font-medium" %></li>
            <% end %>

            <li><%= link_to t('navigation.built_with_ruby'), built_with_ruby_path, class: "rounded-xl font-medium" %></li>
            <li><%= link_to t('navigation.code_of_conduct'), landing_code_of_conduct_path, class: "rounded-xl font-medium" %></li>

<!--            <li class="divider my-1"></li>-->

            <% if user_signed_in? %>
              <li><%= link_to t('navigation.update_profile'), edit_user_registration_path, class: "rounded-xl font-medium" %></li>
              <li><%= button_to t('navigation.sign_out'), destroy_user_session_path, method: :delete, class: "rounded-xl font-medium text-red-600" %></li>
            <% else %>
              <li><%= link_to t('navigation.sign_in'), new_user_session_path, class: "rounded-xl font-medium" %></li>
            <% end %>
          </ul>
        </div>
      </div>

    </div>
  </div>
</nav>
