<% if featured_project %>
  <section class="mb-16">
    <%= turbo_frame_tag "featured_project" do %>
      <div class="bg-gradient-to-br from-ruby-50 to-white border border-ruby-100 rounded-2xl p-8 lg:p-10 shadow-lg hover:shadow-xl hover:shadow-ruby-100/50 transition-all duration-300">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-center">
          <div>
            <div class="inline-flex items-center gap-1.5 bg-ruby-600 text-white rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider mb-4">
              <i class="fa-solid fa-gem text-xs"></i>
              <%= t('projects.featured.title') %>
            </div>
            <p class="text-sm text-gray-500 mb-1 flex items-center gap-1.5">
              <i class="fa-solid fa-location-dot text-ruby-400 text-xs"></i>
              <span class="text-ruby-600 font-semibold"><%= featured_project.chapter.name %></span>
            </p>

            <h3 class="text-2xl font-extrabold text-gray-900 mb-3"><%= featured_project.name %></h3>
            <% if featured_project.intro.present? %>
              <p class="text-gray-600 mb-6 leading-relaxed"><%= featured_project.intro %></p>
            <% end %>

            <div class="flex flex-wrap gap-3">
              <% if featured_project.preview_link.present? %>
                <%= link_to featured_project.preview_link, target: "_blank", rel: "noopener", class: "arc-btn-ruby text-sm" do %>
                  <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                  <%= t('projects.featured.view_project') %>
                <% end %>
              <% end %>
              <% if featured_project.git_link.present? %>
                <%= link_to featured_project.git_link, target: "_blank", rel: "noopener", class: "arc-btn-outline text-sm" do %>
                  <i class="fa-brands fa-github"></i>
                  <%= t('projects.show.github') %>
                <% end %>
              <% end %>
            </div>
          </div>

          <%= link_to project_path(featured_project), class: "block group", data: { turbo_frame: "_top" } do %>
            <div class="bg-gray-100 rounded-2xl overflow-hidden cursor-pointer transition-all duration-300 ring-2 ring-transparent group-hover:ring-ruby-300 group-hover:shadow-lg group-hover:shadow-ruby-100/50" style="aspect-ratio: 16/9;">
              <%= project_image(featured_project, css_class: "w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500") %>
            </div>
          <% end %>
        </div>
      </div>

      <% if @total_featured && @total_featured > 1 %>
        <div class="flex justify-end items-center gap-4 mt-8">
          <div class="flex gap-2">
            <% @total_featured.times do |i| %>
              <button class="w-3 h-3 rounded-full <%= i == (@current_offset % @total_featured) ? 'bg-red-600' : 'bg-gray-300' %>"></button>
            <% end %>
          </div>
          <% current_position = @current_offset % @total_featured %>
          <% unless current_position == 0 %>
            <%= link_to t('projects.featured.prev'), projects_path(featured_offset: @current_offset - 1), class: "text-gray-800 font-medium hover:text-red-600" %>
          <% end %>
          <% unless current_position == @total_featured - 1 %>
            <%= link_to t('projects.featured.next'), projects_path(featured_offset: @current_offset + 1), class: "text-gray-800 font-medium hover:text-red-600" %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </section>
<% end %>
