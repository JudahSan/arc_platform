<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
  <% projects.each do |project| %>
    <div class="arc-card group">
      <%= link_to project_path(project), class: "block" do %>
        <div class="relative aspect-video overflow-hidden bg-gray-200">
          <%= project_image(project, css_class: "w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500") %>
          <% if project.featured? %>
            <div class="absolute top-3 right-3">
              <span class="arc-badge arc-badge-ruby"><%= t('projects.grid.featured') %></span>
            </div>
          <% end %>
          <% if project.git_link.present? %>
            <div class="absolute top-3 left-3">
              <span class="arc-badge bg-gray-900/80 text-white border-transparent"><i class="fa-brands fa-github mr-1"></i>Open Source</span>
            </div>
          <% end %>
        </div>
      <% end %>
      
      <div class="p-5 sm:p-6">
        <%= link_to project_path(project) do %>
          <h3 class="text-base font-bold mb-2 group-hover:text-ruby-600 transition-colors line-clamp-1"><%= project.name %></h3>
        <% end %>
        
        <% if project.intro.present? %>
          <p class="text-sm text-gray-600 mb-4 line-clamp-2"><%= project.intro %></p>
        <% end %>
        
        <!-- Chapter Badge -->
        <% if project.chapter.present? %>
          <div class="inline-flex items-center gap-1 px-3 py-1 bg-gray-100 rounded-full text-xs text-gray-700 mb-4">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span><%= project.chapter.name %></span>
          </div>
        <% end %>
        
        <%# Action Buttons %>
        <div class="flex gap-2 pt-4 border-t border-gray-100">
          <% if project.preview_link.present? %>
            <%= link_to project.preview_link, target: "_blank", rel: "noopener",
                class: "flex-1 inline-flex items-center justify-center gap-2 px-4 py-2 bg-ruby-600 hover:bg-ruby-700 text-white text-xs font-semibold rounded-xl transition-colors",
                onclick: "event.stopPropagation()" do %>
              <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
              <%= t('projects.grid.preview') %>
            <% end %>
          <% end %>

          <% if project.git_link.present? %>
            <%= link_to project.git_link, target: "_blank", rel: "noopener",
                class: "flex-1 inline-flex items-center justify-center gap-2 px-4 py-2 border border-gray-200 hover:border-ruby-300 hover:bg-ruby-50 text-gray-700 hover:text-ruby-700 text-xs font-semibold rounded-xl transition-all",
                onclick: "event.stopPropagation()" do %>
              <i class="fa-brands fa-github text-sm"></i>
              Contribute
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if pagy.pages > 1 %>
  <div class="mt-8 flex justify-center">
    <%== pagy_nav(pagy) %>
  </div>
<% end %>
