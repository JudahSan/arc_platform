<% auth_content = capture do %>
  <%# ── Header strip ── %>
  <div class="arc-hero-ruby px-8 py-8 text-center relative overflow-hidden">
    <figure class="mb-4">
      <%= image_tag 'sign_up_karate.png', alt: "Unlock Account",
          class: "h-24 w-auto object-contain mx-auto opacity-90 drop-shadow-lg" %>
    </figure>
    <h1 class="text-white font-extrabold text-2xl mb-1">Resend Unlock Instructions</h1>
    <p class="text-white/70 text-sm">We'll send you a link to unlock your account 🔓</p>
  </div>

  <%# ── Form body ── %>
  <div class="px-8 py-8">
    <%= simple_form_for(resource, as: resource_name,
        url: unlock_path(resource_name),
        html: { class: 'space-y-4' }) do |f| %>

      <div>
        <label class="block text-sm font-semibold arc-text-base mb-1.5">Email</label>
        <%= f.input :email,
            placeholder: 'Enter email address',
            label: false, wrapper: false,
            input_html: { class: 'arc-input w-full', autofocus: true, autocomplete: 'email' } %>
      </div>

      <div class="pt-2">
        <%= f.button :button, 'Resend instructions',
            class: 'w-full arc-btn-ruby justify-center text-base py-3.5 cursor-pointer' %>
      </div>
    <% end %>

    <div class="mt-6 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
<% end %>
<%= render "devise/shared/auth_card", content: auth_content %>
