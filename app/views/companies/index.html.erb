<div class="bg-white min-h-screen">
  <%# Hero Section %>
  <div class="bg-gradient-to-br from-red-600 to-red-700 py-16 px-4 sm:px-6 lg:px-8 text-center text-white">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-4xl font-extrabold sm:text-5xl md:text-6xl">
        <%= t('companies.index.title') %>
      </h1>
      <p class="mt-4 text-xl max-w-2xl mx-auto opacity-90">
        <%= t('companies.index.subtitle') %>
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <%# Filter Bar - Country Only %>
    <div class="mb-12">
      <div class="flex flex-col sm:flex-row gap-4 items-center justify-between">
        <div class="flex flex-col sm:flex-row gap-3 items-center w-full sm:w-auto">
          <label class="text-sm font-medium text-gray-700 whitespace-nowrap">
            <%= t('companies.index.filter_by_country', default: 'Filter by country:') %>
          </label>
          <%= form_with url: built_with_ruby_path, method: :get, class: "w-full sm:w-72", local: true do |f| %>
            <%= f.select :country,
                         options_for_select([[t('companies.index.all_countries'), ""]] + @countries.map { |c| [c, c] }, params[:country]),
                         {},
                         class: "select select-bordered w-full h-12 text-base focus:border-red-500 focus:ring-2 focus:ring-red-200 transition-all bg-white",
                         onchange: "this.form.submit();" %>
          <% end %>
        </div>

        <%# Submit Company Button %>
        <% if user_signed_in? %>
          <div>
            <%= link_to new_company_path,
                        class: "btn btn-outline border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white h-12 px-6 font-medium whitespace-nowrap transition-all hover:shadow-lg w-full sm:w-auto" do %>
              <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
              <%= t('companies.index.submit_company') %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%# Company Grid %>
    <% if @companies.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @companies.each do |company| %>
          <div class="card bg-base-100 shadow-xl border border-gray-100 hover:shadow-2xl transition-shadow duration-300">
            <div class="px-6 pt-6 flex justify-center h-32 w-full">
              <% if company.logo.attached? %>
                <%= image_tag company.logo, class: "h-full w-full object-contain", alt: company.name %>
              <% else %>
                <div class="h-24 w-24 bg-gray-100 flex items-center justify-center rounded-lg">
                  <span class="text-3xl font-bold text-gray-300"><%= company.name[0] %></span>
                </div>
              <% end %>
            </div>

            <div class="card-body">
              <div class="flex justify-between items-start">
                <h2 class="card-title text-xl font-bold text-gray-800"><%= company.name %></h2>
                <% if company.featured? %>
                  <div class="badge badge-secondary bg-yellow-400 border-none text-black text-xs font-bold uppercase"><%= t('companies.index.featured') %></div>
                <% end %>
              </div>

              <div class="flex items-center text-sm text-gray-500 mb-2">
                <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <%= [company.city, company.country].reject(&:blank?).join(", ") %>
              </div>

              <p class="text-gray-600 line-clamp-3 mb-4">
                <%= company.description %>
              </p>

              <div class="card-actions justify-between items-center pt-4 border-t border-gray-50">
                <% if company.website_url.present? %>
                  <%= link_to company.website_url, target: "_blank", class: "text-red-600 hover:text-red-800 text-sm font-semibold flex items-center" do %>
                    <%= t('companies.index.website') %>
                    <svg class="h-4 w-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                  <% end %>
                <% end %>

                <% if company.careers_url.present? %>
                  <%= link_to company.careers_url, target: "_blank", class: "btn btn-sm btn-ghost text-gray-600 hover:text-red-600" do %>
                    <%= t('companies.index.careers') %>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-20 bg-gray-50 rounded-xl">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 9.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <h3 class="mt-2 text-lg font-medium text-gray-900"><%= t('companies.index.no_companies') %></h3>
      </div>
    <% end %>
  </div>
</div>
