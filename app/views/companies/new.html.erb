<div class="bg-white min-h-screen py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12">
      <h1 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">
        <%= t('companies.new.title') %>
      </h1>
      <p class="mt-4 text-lg text-gray-500">
        <%= t('companies.new.subtitle') %>
      </p>
    </div>

    <div class="bg-white shadow-xl rounded-lg overflow-hidden border border-gray-100">
      <div class="px-6 py-8">
        <%= form_with model: @company, class: "space-y-6" do |f| %>
          <% if @company.errors.any? %>
            <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-6">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800">
                    <%= pluralize(@company.errors.count, "error") %> prohibited this company from being saved:
                  </h3>
                  <div class="mt-2 text-sm text-red-700">
                    <ul class="list-disc pl-5 space-y-1">
                      <% @company.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
              <%= f.text_field :name, class: "mt-1 input input-bordered w-full focus:border-red-600 focus:outline-none" %>
            </div>

            <div class="sm:col-span-2">
              <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
              <%= f.text_area :description, rows: 4, class: "mt-1 textarea textarea-bordered w-full focus:border-red-600 focus:outline-none" %>
            </div>

            <div>
              <%= f.label :country, class: "block text-sm font-medium text-gray-700" %>
              <%= f.text_field :country, class: "mt-1 input input-bordered w-full focus:border-red-600 focus:outline-none", placeholder: "e.g. Kenya" %>
            </div>

            <div>
              <%= f.label :city, class: "block text-sm font-medium text-gray-700" %>
              <%= f.text_field :city, class: "mt-1 input input-bordered w-full focus:border-red-600 focus:outline-none", placeholder: "e.g. Nairobi" %>
            </div>

            <div class="sm:col-span-2">
              <%= f.label :website_url, class: "block text-sm font-medium text-gray-700" %>
              <%= f.url_field :website_url, class: "mt-1 input input-bordered w-full focus:border-red-600 focus:outline-none", placeholder: "https://example.com" %>
            </div>

            <div class="sm:col-span-2">
              <%= f.label :careers_url, class: "block text-sm font-medium text-gray-700" %>
              <%= f.url_field :careers_url, class: "mt-1 input input-bordered w-full focus:border-red-600 focus:outline-none", placeholder: "https://example.com/careers" %>
            </div>

            <div class="sm:col-span-2">
              <%= f.label :logo, class: "block text-sm font-medium text-gray-700" %>
              <%= f.file_field :logo, class: "mt-1 file-input file-input-bordered w-full focus:border-red-600 focus:outline-none" %>
            </div>
          </div>

          <div class="pt-5 flex items-center justify-end gap-x-6">
            <%= link_to t('companies.new.back_button'), built_with_ruby_path, class: "text-sm font-semibold leading-6 text-gray-900" %>
            <%= f.submit t('companies.new.submit_button'), class: "btn btn-primary bg-red-600 hover:bg-red-700 border-none text-white px-8" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
